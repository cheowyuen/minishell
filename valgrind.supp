# Valgrind suppression file for minishell
# This suppresses "still reachable" memory from readline and libtinfo libraries
# These are not actual memory leaks - they're library internal allocations
# that are intentionally kept until program termination for performance.

# Readline library suppressions
{
   readline_malloc_init
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:malloc
   ...
   fun:rl_initialize
   fun:readline
}

{
   readline_xmalloc_init
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:*alloc
   fun:xmalloc
   ...
   fun:rl_initialize
   fun:readline
}

{
   readline_xrealloc_init
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:*alloc
   fun:xrealloc
   ...
   fun:rl_initialize
   fun:readline
}

