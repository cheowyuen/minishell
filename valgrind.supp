# Standard library suppressions for readline/ncurses
{
   strdup_for_libraries
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:*alloc
   fun:strdup
   ...
   obj:*/lib*/*libtinfo.so*
   ...
   fun:readline
}

{
   strdup_for_readline
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:*alloc
   fun:strdup
   ...
   obj:*/lib*/*libreadline.so*
   ...
   fun:readline
}

# Generic suppression for any remaining readline/libtinfo allocations
{
   readline_library_general
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:*alloc
   ...
   obj:*/lib*/*libreadline.so*
